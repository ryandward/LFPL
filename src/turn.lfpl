# The runtime's turn: LFPL-O section 3.3's ADMIT, REFUSE and DONE, and the output queue, for the hardware target.
# src/turn.py fills in what depends on the handler: its item, the verdict it returns, and how long the queue is,
# and appends this to the handler's program. One turn is one call of `serve`, which the machine makes forever.

# The pool. It is laid out as a Free is, and it is not one: running out of it is Short, which happens, where a
# reserve of R(n) cells never runs out. So rtcheck charges this one's empty arm, and not a reserve's.
data Pool = Dry | Cell(next: Pool);

# The slots no frame holds, a cell each. A frame that is sent takes ingress's slot into the queue with it, and ingress
# takes one of these in its place. When egress has sent the frame, its slot comes back here, in the cell that was its
# place in the queue.
data Spares = NoSpare | Spare(spare: $slot_type, rest: Spares);

# An output waiting to be sent: the port its verdict named, and the record. It takes a cell of its own.
data Out = None | Pending(port: Int8, frame: $item);

# The queue holds $k_out outputs, oldest first: its head, which is the turn's own parameter, and the places after it.
# The head is the only output a turn can release, so the bound pays for releasing one frame, and nothing for the
# frames behind it. Full is the last place being taken, read from that place and from no count.
record Queue { $queue_fields };

# What became of a turn, for the machine's counters: for a frame the handler decided, with the tag of its verdict.
enum Turned = Idle | Queued(verdict: Int8) | Dropped(verdict: Int8) | Runt | TooLarge | Short | Full;

fn give(cells: Pool, pool: Pool) : Pool = match cells with Dry => pool | Cell(c, rest) => give(rest, Cell@c(pool)) end;

# What a handler gave back of its reserve. This is not a draw: the Free was the handler's, and it does run out.
fn give_free(free: Free, pool: Pool) : Pool = match free with End => pool | More(c, rest) => give_free(rest, Cell@c(pool)) end;

# A record that has gone: its cells go back to the pool, and its slot to the spares, in the cell `e` that held it in
# the queue.
fn give_frame(frame: $item, e: Diamond, pool: Pool, spares: Spares) : (Pool, Spares) = match frame with $pattern =>
  $peel_cells ($cells_to_pool, Spare@e($slot_binder, spares)) end;

fn give_out(out: Out, pool: Pool, spares: Spares) : (Pool, Spares) = match out with
  | None => (pool, spares)
  | Pending(e, port, frame) => give_frame(frame, e, pool, spares) end;

fn is_full(queue: Queue) : (Queue, Bool) = match queue with $queue_pattern =>
  match $last_place with
  | None => (Queue@d { $last_place = None }, false)
  | Pending(e, port, frame) => (Queue@d { $last_place = Pending@e(port, frame) }, true) end end;

# What egress has sent leaves the queue, its cells go back to the pool and its slot to the spares, and the place after
# it is the new head.
fn release(head: Out, queue: Queue, pool: Pool, spares: Spares) : (Out, Queue, Pool, Spares) = match head with
  | None => (None, queue, pool, spares)
  | Pending(e, port, frame) => match queue with $queue_pattern =>
      let (pool1, spares1) = give_frame(frame, e, pool, spares) in ($first_place, Queue@d { $shifted }, pool1, spares1)
  end end;

# Into the first free place, the head first. What comes back is the output, if there was none, which is_full has
# ruled out.
fn enqueue(head: Out, queue: Queue, out: Out) : (Out, Queue, Out) = match head with
  | None => (out, queue, None)
  | Pending(h, port, frame) => match queue with $queue_pattern =>
$enqueue_body;

# One turn. What egress has sent goes back first. Then the frame ingress holds, if there is one, is refused or
# admitted: ADMIT, the handler, then DONE. Ingress keeps its record: the handler is given it, and it is ingress's
# again afterwards, so on the hardware target its cells can be registers. What goes into the queue is a copy of it,
# in cells taken from the pool by matching it, with one more for the copy's place in the queue, and with the slot the
# frame is in: ingress takes a spare one in its place, whose cell goes back to the pool. Running dry, of cells or of
# spare slots, gives back what was taken.
#
# The machine says two things in one integer, since a function takes six: bit 15 is that egress has sent the head of
# the queue, and below it is how long the frame ingress holds is, or 0 if there is none.
turn serve(pool: Pool, spares: Spares, ingress: $item, head: Out, queue: Queue, event: Int16)
    : (Pool, Spares, $item, Out, Queue, Turned) =
  let sent = !=(&(event, 0x8000), 0) in
  let length = &(event, 0x7FFF) in
  let (head0, queue0, pool0, spares0) = if sent then release(head, queue, pool, spares) else (head, queue, pool, spares) in
  if ==(length, 0) then (pool0, spares0, ingress, head0, queue0, Idle)
  else if <(length, $wire) then (pool0, spares0, ingress, head0, queue0, Runt)
  else if >(length, $capacity) then (pool0, spares0, ingress, head0, queue0, TooLarge)
  else
$take
  let (queue1, full) = is_full(queue0) in
  if full then ($taken_back, spares0, ingress, head0, queue1, Full)
  else match spares0 with
  | NoSpare => ($taken_back, NoSpare, ingress, head0, queue1, Short)
  | Spare(s, fresh, spares1) =>
      let (verdict, out, free) = $handler(ingress, End) in
      let pool2 = give_free(free, $after_take) in
      match out with $out_pattern =>
      match verdict with
$done_arms
      end end
  end$take_end;
