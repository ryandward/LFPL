# The runtime's turn: LFPL-O section 3.3's ADMIT, REFUSE and DONE, and the output queue, for the hardware target.
# src/turn.py fills in what depends on the handler: its item, the verdict it returns, and how long the queue is,
# and appends this to the handler's program. One turn is one call of `serve`, which the machine makes forever.
$chain_definition
# The pool. It is laid out as a Free is, and it is not one: running out of it is Short, which happens, where a
# reserve of R(n) cells never runs out. So rtcheck charges this one's empty arm, and not a reserve's.
data Pool = Dry | Cell(next: Pool);

# An output waiting to be sent: the port its verdict named, and the record. It takes a cell of its own.
data Out = None | Pending(port: Int8, frame: $item);

# The queue: $k_out places, oldest first. Full is the last place being taken, read from that place and from no count.
record Queue { $queue_fields };

# What became of a turn, for the machine's counters.
enum Turned = Idle | Queued | Dropped | Runt | TooLarge | Short | Full;

fn give(cells: Pool, pool: Pool) : Pool = match cells with Dry => pool | Cell(c, rest) => give(rest, Cell@c(pool)) end;

fn give_chain(chain: $chain_type, pool: Pool) : Pool = match chain with
  | $last => pool
  | $chunk(c, used, b0, b1, b2, b3, b4, b5, b6, next) => give_chain(next, Cell@c(pool)) end;

# What a handler gave back of its reserve. This is not a draw: the Free was the handler's, and it does run out.
fn give_free(free: Free, pool: Pool) : Pool = match free with End => pool | More(c, rest) => give_free(rest, Cell@c(pool)) end;

# Every cell of a record goes back: each of its own, and its chain's.
fn give_frame(frame: $item, pool: Pool) : Pool = match frame with $pattern =>
  $peel_cells give_chain($chain_binder, $cells_to_pool) end;

fn give_out(out: Out, pool: Pool) : Pool = match out with None => pool | Pending(e, port, frame) => give_frame(frame, Cell@e(pool)) end;

# The chunks of ingress the frame reached go onto `item`, newest first, and one cell from the pool onto `fresh` for
# each, to take its place. n is found this way, with no division: `left` is the frame's bytes not yet placed. Running
# dry stops the walk, and says so.
fn split(chain: $chain_type, left: Int16, item: $chain_type, fresh: Pool, pool: Pool) : ($chain_type, $chain_type, Pool, Pool, Bool) =
  if ==(left, 0) then (chain, item, fresh, pool, true)
  else match chain with
  | $last => ($last, item, fresh, pool, false)
  | $chunk(c, used, b0, b1, b2, b3, b4, b5, b6, next) => match pool with
      | Dry => ($chunk@c(used, b0, b1, b2, b3, b4, b5, b6, next), item, fresh, Dry, false)
      | Cell(p, rest) => split(next, if <=(left, 7) then 0 else -(left, 7),
                               $chunk@c(used, b0, b1, b2, b3, b4, b5, b6, item), Cell@p(fresh), rest)
      end
  end;

# Back in order, onto `chain`: the first chunk taken is the last one on `item`.
fn unsplit(item: $chain_type, chain: $chain_type) : $chain_type = match item with
  | $last => chain
  | $chunk(c, used, b0, b1, b2, b3, b4, b5, b6, older) => unsplit(older, $chunk@c(used, b0, b1, b2, b3, b4, b5, b6, chain)) end;

# Cells from the pool, as empty chunks of ingress.
fn refill(fresh: Pool, chain: $chain_type) : $chain_type = match fresh with
  | Dry => chain
  | Cell(c, rest) => refill(rest, $chunk@c(0, 0, 0, 0, 0, 0, 0, 0, chain)) end;

fn is_full(queue: Queue) : (Queue, Bool) = match queue with $queue_pattern =>
  match $last_place with
  | None => (Queue@d { $last_place = None }, false)
  | Pending(e, port, frame) => (Queue@d { $last_place = Pending@e(port, frame) }, true) end end;

# What egress has sent leaves the queue, and its cells go back to the pool.
fn release(queue: Queue, pool: Pool) : (Queue, Pool) = match queue with $queue_pattern =>
  match q0 with
  | None => (Queue@d { q0 = None }, pool)
  | Pending(e, port, frame) => (Queue@d { $shifted }, give_frame(frame, Cell@e(pool))) end end;

# Into the first free place. What comes back is the output, if there was none, which is_full has ruled out.
fn enqueue(queue: Queue, out: Out) : (Queue, Out) = match queue with $queue_pattern =>
$enqueue_body;

# One turn. What egress has sent goes back first. Then the frame ingress holds, if there is one, is refused or
# admitted: ADMIT, the handler, then DONE. The cells come out of the pool by matching it, one for each the item
# takes out of ingress and one for the output's place in the queue, and running dry gives back what was taken.
turn serve(pool: Pool, slot: $item, queue: Queue, length: Int16, sent: Bool) : (Pool, $item, Queue, Turned) =
  let (queue0, pool0) = if sent then release(queue, pool) else (queue, pool) in
  if ==(length, 0) then (pool0, slot, queue0, Idle)
  else if <(length, $wire) then (pool0, slot, queue0, Runt)
  else if >(length, $capacity) then (pool0, slot, queue0, TooLarge)
  else
$take
  match slot with $pattern =>
    let (rest, item, fresh, pool1, ok) = split($chain_binder, -(length, $wire), $last, Dry, $after_take) in
    if !(ok) then (give(fresh, $taken_back), $item@d { $chain_field = unsplit(item, rest) }, queue0, Short)
    else let (queue1, full) = is_full(queue0) in
    if full then (give(fresh, $taken_back), $item@d { $chain_field = unsplit(item, rest) }, queue1, Full)
    else
      let (verdict, out, free) = $handler($item@d { $chain_field = unsplit(item, $last) }, End) in
      let pool2 = give_free(free, pool1) in
      let slot1 = $fresh_record in
      match verdict with
$done_arms
      end
  end$take_end;
